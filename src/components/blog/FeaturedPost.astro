---
/** Articolul promovat: card lat, cu imagine, pentru capul paginii de noutati. */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import { formatDate, isoDate } from '../../lib/utils';

interface Props {
  post: CollectionEntry<'articole'>;
  categoryName?: string;
  /** Eticheta din coltul imaginii. */
  label?: string;
}

const { post, categoryName, label = 'Recomandat' } = Astro.props;
const href = `/noutati/${post.id}`;
---

<article
  class="border-stroke bg-surface shadow-card card-surface hover:border-brand/40 group grid overflow-hidden rounded-2xl border transition hover:shadow-md lg:grid-cols-2"
>
  <div class="bg-surface-alt relative aspect-[16/10] overflow-hidden lg:aspect-auto lg:h-full lg:min-h-[320px]">
    {
      post.data.cover ? (
        <Image
          src={post.data.cover}
          alt={post.data.coverAlt ?? ''}
          widths={[640, 1280]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="from-brand to-brand-dark h-full w-full bg-gradient-to-br" />
      )
    }
    <span class="bg-surface text-brand absolute top-4 left-4 rounded-full px-3 py-1.5 text-xs font-semibold shadow-sm">
      {label}
    </span>
  </div>

  <div class="flex flex-col items-start gap-3 p-6 lg:justify-center lg:p-10">
    {categoryName && <Badge>{categoryName}</Badge>}

    <h3 class="font-heading text-ink text-2xl leading-8 font-bold text-balance lg:text-3xl lg:leading-10">
      <a href={href} class="group-hover:text-brand card-link">{post.data.title}</a>
    </h3>

    <p class="text-ink-muted text-base leading-7 text-pretty">{post.data.excerpt}</p>

    <p class="text-ink-subtle text-xs">
      <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
    </p>

    <span class="text-brand inline-flex items-center gap-1 text-sm font-semibold">
      Citește articolul
      <Icon name="arrow-right" size={16} />
    </span>
  </div>
</article>
