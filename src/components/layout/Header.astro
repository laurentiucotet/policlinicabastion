---
import Logo from './Logo.astro';
import TopBar from './TopBar.astro';
import SearchBox from './SearchBox.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { navigation, site } from '../../lib/site';
import { getSpecializari } from '../../lib/content';

const pathname = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));

/* Submeniurile se completeaza automat din continut, ca sa nu fie nevoie sa fie
 * tinute manual in sincron din CMS:
 *   /specializari -> lista specializarilor
 *   /afectiuni, /servicii -> catalogul filtrat pe specializare
 * Daca in navigation.json exista deja copii scrisi de mana, ei au prioritate. */
const specializari = await getSpecializari();

const autoChildren: Record<string, { label: string; href: string }[]> = {
  '/specializari': specializari.map((s) => ({ label: s.data.title, href: `/specializari/${s.id}` })),
  '/afectiuni': specializari.map((s) => ({ label: s.data.title, href: `/afectiuni?categorie=${s.id}` })),
  '/servicii': specializari.map((s) => ({ label: s.data.title, href: `/servicii?categorie=${s.id}` })),
};

const items = navigation.main.map((item) =>
  item.children.length ? item : { ...item, children: autoChildren[item.href] ?? [] },
);
---

{/*
  Pe ecrane mici header-ul se retrage la derulare — vezi scriptul de mai jos.
  Deplasarea se face printr-o variabila CSS, ca sub-navigatia paginilor de
  catalog sa se poata alinia cu el (`AnchorNav` o adauga la propriul `top`).
*/}
<header
  class="sticky top-0 z-50 translate-y-[var(--header-shift,0px)] transition-transform duration-300 motion-reduce:transition-none"
  data-header
>
  <TopBar />

  <div class="border-stroke bg-surface/95 relative border-b backdrop-blur">
    <div class="container-page flex h-[84px] items-center justify-between gap-6">
      <Logo />

      <nav class="hidden items-center gap-4 xl:flex 2xl:gap-6" aria-label="Meniu principal">
        {
          items.map((item) =>
            item.children.length ? (
              <div class="group relative">
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center gap-1 py-3 text-sm font-semibold whitespace-nowrap transition-colors 2xl:text-base',
                    isActive(item.href) ? 'text-brand' : 'text-ink hover:text-brand',
                  ]}
                  aria-haspopup="true"
                >
                  {item.label}
                  <Icon name="chevron-down" size={16} />
                </a>
                <div class="invisible absolute top-full left-0 z-10 min-w-56 translate-y-1 opacity-0 transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                  <ul class="border-stroke bg-surface rounded-2xl border p-2 shadow-lg">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class="text-ink-muted hover:bg-surface-alt hover:text-brand block rounded-lg px-3 py-2 text-sm"
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class:list={[
                  'py-3 text-sm font-semibold whitespace-nowrap transition-colors 2xl:text-base',
                  isActive(item.href) ? 'text-brand' : 'text-ink hover:text-brand',
                ]}
              >
                {item.label}
              </a>
            ),
          )
        }
      </nav>

      <div class="flex items-center gap-2">
        <SearchBox />
        {/* Wrapper-ul ascunde butonul pe ecrane mici: `hidden` pus direct pe
            Button ar pierde in fata lui `inline-flex` din stilul de baza. */}
        <span class="hidden sm:block">
          <Button href={site.booking.href} class="whitespace-nowrap">{site.booking.label}</Button>
        </span>
        <button
          type="button"
          class="text-ink hover:bg-surface-alt rounded-lg p-2 xl:hidden"
          aria-label="Deschide meniul"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
        >
          <Icon name="menu" size={24} />
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    hidden
    class="border-stroke bg-surface max-h-[calc(100dvh-140px)] overflow-y-auto border-b xl:hidden"
  >
    <nav class="container-page flex flex-col gap-1 py-4" aria-label="Meniu mobil">
      {
        items.map((item) =>
          item.children.length ? (
            <details class="border-stroke border-b last:border-0">
              <summary class="text-ink flex cursor-pointer list-none items-center justify-between py-3 text-base font-semibold">
                {item.label}
                <Icon name="chevron-down" size={18} />
              </summary>
              <ul class="pb-2">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="text-ink-muted hover:text-brand block py-2 pl-3 text-sm">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a href={item.href} class="border-stroke text-ink hover:text-brand border-b py-3 text-base font-semibold last:border-0">
              {item.label}
            </a>
          ),
        )
      }
      <Button href={site.booking.href} class="mt-3 w-full">{site.booking.label}</Button>
    </nav>
  </div>
</header>

<script>
  /* Header-ul e sticky si isi schimba inaltimea in functie de latimea ecranului
   * (bara de sus se desface pe doua randuri pe mobil). Publicam inaltimea reala
   * ca variabila CSS, ca ancorele si sub-navigatia paginilor de catalog sa se
   * alinieze sub el, fara valori magice. */
  const header = document.querySelector('header');

  if (header) {
    const publishHeight = () =>
      document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);

    publishHeight();
    new ResizeObserver(publishHeight).observe(header);
  }

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  /* --------------------------------------------------------------------- *
   * Retragerea header-ului la derulare, pe ecrane mici
   *
   * Pe telefon, header-ul mananca aproape un sfert din ecran: bara albastra
   * cu adresa si telefonul se rupe pe doua randuri, iar sub ea sta bara de
   * navigatie. Sunt utile la aterizare, nu si dupa ce omul a inceput sa
   * citeasca.
   *
   * Doua trepte, nu una:
   *   - **derulare in jos** ascunde tot header-ul;
   *   - **derulare in sus** aduce inapoi doar bara de navigatie (logo,
   *     cautare, meniu), fara bara albastra. Cine deruleaza in sus cauta de
   *     obicei meniul, nu programul clinicii.
   *   - **sus de tot** readuce totul.
   *
   * Se misca prin `--header-shift`, nu prin `position`: `AnchorNav` adauga
   * aceeasi variabila la propriul `top`, deci sub-navigatia paginilor de
   * catalog urca odata cu header-ul, fara sa ramana o banda goala sub ea.
   * --------------------------------------------------------------------- */
  if (header) {
    const topbar = header.querySelector<HTMLElement>('[data-topbar]');
    const root = document.documentElement;
    // Peste `xl` header-ul incape oricum: acolo ramane pe loc.
    const compact = matchMedia('(max-width: 1279.98px)');

    const setShift = (pixels: number) =>
      root.style.setProperty('--header-shift', pixels === 0 ? '0px' : `-${pixels}px`);

    let lastY = window.scrollY;
    let navHidden = false;
    let queued = false;

    const apply = () => {
      queued = false;
      const y = window.scrollY;
      const menuOpen = menu ? !menu.hidden : false;

      // Cu meniul deschis header-ul nu se misca: meniul e in interiorul lui.
      if (!compact.matches || menuOpen) {
        navHidden = false;
        setShift(0);
        lastY = y;
        return;
      }

      const topbarHeight = topbar?.offsetHeight ?? 0;

      if (y <= topbarHeight) {
        navHidden = false;
        setShift(0);
        lastY = y;
        return;
      }

      // Pragul de 4px ignora tremuratul din derularea cu inertie.
      if (y > lastY + 4) navHidden = true;
      else if (y < lastY - 4) navHidden = false;

      lastY = y;
      setShift(navHidden ? header.offsetHeight : topbarHeight);
    };

    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(apply);
    };

    apply();
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    compact.addEventListener('change', apply);

    toggle?.addEventListener('click', () => requestAnimationFrame(apply));
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Deschide meniul' : 'Închide meniul');
    if (menu) menu.hidden = open;
  });
</script>
