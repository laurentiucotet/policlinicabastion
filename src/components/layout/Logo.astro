---
/**
 * Sigla clinicii, in antet si in subsol.
 *
 * Semnul e fisierul primit de la client, desenat intr-o singura culoare, si se
 * coloreaza prin `currentColor`: albastrul lui pe fundal deschis, alb pe fundal
 * inchis. Culoarea lui (`--color-logo`) e usor diferita de albastrul
 * interfetei; asa a venit sigla si asa ramane.
 */
interface Props {
  class?: string;
  /** Varianta pentru fundal inchis (footer / bara albastra). */
  tone?: 'dark' | 'light';
}
const { class: className = '', tone = 'dark' } = Astro.props;
const label = tone === 'light' ? 'text-white' : 'text-ink';
const mark = tone === 'light' ? 'text-white' : 'text-logo';
---

<a href="/" class:list={['flex items-center gap-3', className]} aria-label="Policlinica Bastion - acasa">
  <svg
    width="40"
    height="40"
    viewBox="0 0 392 392"
    fill="currentColor"
    aria-hidden="true"
    class:list={['shrink-0', mark]}
  >
    <path d="M391.297 224.256L355.131 160.813L367.64 88.5439L299.659 63.4427L263.493 0L195.513 25.1012L127.668 0L91.5021 63.5806L23.5213 88.6818L36.1658 160.951L0 224.532L55.4723 271.7L68.1167 343.97H140.448L195.92 391.138L234.534 358.175L251.257 343.97H323.588L336.097 271.7L391.433 224.532L391.297 224.256ZM293.541 226.049H228.007V292.526H163.018V226.049H97.7563V160.124H163.29V93.7848H228.279V160.262H293.813V226.187L293.541 226.049Z"></path>
  </svg>
  <span class:list={['font-heading text-xl leading-6 font-bold', label]}>
    Policlinica<br />Bastion
  </span>
</a>
