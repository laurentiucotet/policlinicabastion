---
interface Props {
  class?: string;
  /** Varianta pentru fundal inchis (footer / bara albastra). */
  tone?: 'dark' | 'light';
}
const { class: className = '', tone = 'dark' } = Astro.props;
const label = tone === 'light' ? 'text-white' : 'text-ink';
---

<a href="/" class:list={['flex items-center gap-3', className]} aria-label="Policlinica Bastion - acasa">
  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true" class="shrink-0">
    <rect width="40" height="40" rx="12" fill="#2563EB"></rect>
    <path
      d="M17 10h6a1 1 0 0 1 1 1v5h5a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-5v5a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1v-5h-5a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1h5v-5a1 1 0 0 1 1-1Z"
      fill="#fff"></path>
  </svg>
  <span class:list={['font-heading text-xl leading-6 font-bold', label]}>
    Policlinica<br />Bastion
  </span>
</a>
