---
import Icon from '../ui/Icon.astro';
import { site } from '../../lib/site';
---

<div class="bg-brand-dark text-white">
  <div class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-1.5 text-xs leading-[18px]">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-1">
      <span class="flex items-center gap-1.5">
        <Icon name="map-pin" size={14} />
        {site.topBar.addressShort}
      </span>
      <span class="flex items-center gap-1.5">
        <Icon name="phone" size={14} />
        {site.topBar.phonesShort}
      </span>
    </div>
    <span class="flex items-center gap-1.5">
      <Icon name="clock" size={14} />
      {site.topBar.hoursShort}
    </span>
  </div>
</div>
