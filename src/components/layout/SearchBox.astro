---
/**
 * Cautarea din header. Nu este o pagina, ci o functie disponibila peste tot:
 * butonul deschide un panou cu sugestii live (specializari, afectiuni,
 * interventii, servicii, medici, articole). Enter duce la pagina de rezultate,
 * /rezultate-cautare, singurul loc unde cautarea are pagina proprie.
 */
import Icon from '../ui/Icon.astro';
---

<div class="flex items-center" data-search>
  <button
    type="button"
    class="text-ink hover:bg-surface-alt hover:text-brand rounded-lg p-2"
    aria-label="Caută pe site"
    aria-expanded="false"
    aria-controls="site-search-panel"
    data-search-toggle
  >
    <Icon name="search" size={20} />
  </button>
</div>

<div
  id="site-search-panel"
  hidden
  class="border-stroke bg-surface absolute inset-x-0 top-full border-b shadow-lg"
>
  <div class="container-page py-4">
    <form action="/rezultate-cautare" method="get" role="search" data-search-form>
      <label class="sr-only" for="site-search-input">Caută pe site</label>
      <div class="relative">
        <span class="text-ink-subtle pointer-events-none absolute top-1/2 left-3 -translate-y-1/2">
          <Icon name="search" size={18} />
        </span>
        <input
          id="site-search-input"
          type="search"
          name="q"
          placeholder="Caută o afecțiune, o intervenție, un medic..."
          autocomplete="off"
          class="border-stroke text-ink placeholder:text-ink-subtle focus:border-brand w-full rounded-lg border py-3 pr-3 pl-10 text-base focus:outline-none"
          data-search-input
        />
      </div>
    </form>

    <p class="text-ink-subtle mt-3 text-xs" data-search-hint>
      Scrie cel puțin 2 caractere. Apasă Enter pentru toate rezultatele.
    </p>

    <ul class="divide-stroke mt-1 max-h-[50vh] divide-y overflow-y-auto" data-search-results></ul>

    <a href="/rezultate-cautare" class="text-brand hover:text-brand-dark mt-3 hidden text-sm font-semibold" data-search-all>
      Vezi toate rezultatele
    </a>
  </div>
</div>

<script>
  type Entry = { type: string; title: string; description: string; url: string; keywords?: string[] };

  const wrapper = document.querySelector<HTMLElement>('[data-search]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-search-toggle]');
  const panel = document.getElementById('site-search-panel');
  const form = document.querySelector<HTMLFormElement>('[data-search-form]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const results = document.querySelector<HTMLElement>('[data-search-results]');
  const hint = document.querySelector<HTMLElement>('[data-search-hint]');
  const allLink = document.querySelector<HTMLAnchorElement>('[data-search-all]');

  const normalize = (value: string) =>
    value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (char) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] ?? char,
    );

  /**
   * Potrivirile din titlu conteaza mai mult decat cele din descriere sau din
   * cuvinte-cheie. Comparam si o radacina de 6 litere, ca „biopsie" sa
   * gaseasca „Biopsia de prostata" - flexiunea din romana ar rata altfel exact
   * rezultatul cel mai relevant.
   */
  const score = (entry: Entry, query: string) => {
    const title = normalize(entry.title);
    const stem = query.length > 6 ? query.slice(0, 6) : query;
    if (title.startsWith(query) || title.startsWith(stem)) return 3;
    if (title.includes(query) || title.includes(stem)) return 2;
    if (normalize(entry.description).includes(query)) return 1;
    return 0;
  };

  let entries: Entry[] | null = null;
  let loading: Promise<void> | null = null;

  const load = () => {
    if (entries) return Promise.resolve();
    loading ??= fetch('/cautare-index.json')
      .then((response) => response.json())
      .then((data: Entry[]) => {
        entries = data;
      })
      .catch(() => {
        entries = [];
      });
    return loading;
  };

  const open = () => {
    if (!panel || !toggle) return;
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    void load();
    input?.focus();
  };

  const close = () => {
    if (!panel || !toggle) return;
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
  };

  const render = async () => {
    if (!input || !results || !hint || !allLink) return;
    const query = normalize(input.value.trim());

    if (query.length < 2) {
      results.innerHTML = '';
      hint.textContent = 'Scrie cel puțin 2 caractere. Apasă Enter pentru toate rezultatele.';
      allLink.classList.add('hidden');
      return;
    }

    await load();

    const matches = (entries ?? [])
      .filter((entry) =>
        normalize(`${entry.title} ${entry.description} ${entry.type} ${(entry.keywords ?? []).join(' ')}`).includes(
          query,
        ),
      )
      .sort((a, b) => score(b, query) - score(a, query));

    results.innerHTML = matches
      .slice(0, 6)
      .map(
        (entry) => `
          <li>
            <a href="${entry.url}" class="group block py-2.5">
              <span class="text-chip-ink text-xs font-semibold">${escapeHtml(entry.type)}</span>
              <span class="text-ink group-hover:text-brand block text-sm font-semibold">${escapeHtml(entry.title)}</span>
              <span class="text-ink-muted line-clamp-1 block text-xs">${escapeHtml(entry.description)}</span>
            </a>
          </li>`,
      )
      .join('');

    hint.textContent = matches.length
      ? `${matches.length} ${matches.length === 1 ? 'rezultat' : 'rezultate'}`
      : 'Niciun rezultat. Încearcă alt termen.';

    allLink.href = `/rezultate-cautare?q=${encodeURIComponent(input.value.trim())}`;
    allLink.classList.toggle('hidden', matches.length <= 6);
  };

  toggle?.addEventListener('click', () => (panel?.hidden ? open() : close()));
  input?.addEventListener('input', () => void render());
  form?.addEventListener('submit', () => close());

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !panel?.hidden) {
      close();
      toggle?.focus();
    }
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    if (panel?.hidden) return;
    if (panel?.contains(target) || wrapper?.contains(target)) return;
    close();
  });
</script>
