---
/**
 * Subsolul site-ului. Fundal inchis, ca sa inchida vizual pagina si sa se
 * distinga de benzile CTA albastre de deasupra lui.
 *
 * Contine o singura actiune de programare: restul paginii are deja destule
 * (butonul din header, cel din capul paginii, banda CTA). Telefonul, WhatsApp-ul
 * si adresa raman linkuri, nu butoane.
 */
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { navigation, site, whatsappHref } from '../../lib/site';

const year = new Date().getFullYear();

const contact = [
  { icon: 'map-pin' as const, label: `${site.address.street}, ${site.address.city}`, href: site.address.mapsUrl },
  ...site.phones.map((phone) => ({ icon: 'phone' as const, label: phone.value, href: phone.href })),
  { icon: 'mail' as const, label: site.email, href: `mailto:${site.email}` },
];

const social = [
  { icon: 'facebook' as const, href: site.social.facebook, label: 'Facebook' },
  { icon: 'instagram' as const, href: site.social.instagram, label: 'Instagram' },
  { icon: 'linkedin' as const, href: site.social.linkedin, label: 'LinkedIn' },
].filter((item) => Boolean(item.href));
---

<footer class="bg-ink text-white/70">
  <div class="container-page py-12 lg:py-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.4fr)_repeat(3,minmax(0,1fr))] lg:gap-8">
      <div class="flex flex-col gap-5">
        <Logo tone="light" />

        <p class="max-w-sm text-sm leading-6">
          Policlinică medicală privată în Timișoara. Consultații de specialitate, investigații și intervenții minim
          invazive, majoritatea decontate prin CNAS.
        </p>

        <ul class="flex flex-col gap-2.5 text-sm">
          {
            contact.map((item) => (
              <li>
                <a href={item.href} class="flex items-start gap-2.5 transition-colors hover:text-white">
                  <span class="mt-0.5 text-white/50">
                    <Icon name={item.icon} size={16} />
                  </span>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="flex flex-wrap items-center gap-3">
          <Button href={site.booking.href} class="whitespace-nowrap">{site.booking.label}</Button>
          {
            whatsappHref && (
              <a
                href={whatsappHref}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 text-sm font-semibold text-white/80 transition-colors hover:text-white"
              >
                <span class="text-whatsapp">
                  <Icon name="whatsapp" size={18} />
                </span>
                WhatsApp
              </a>
            )
          }
        </div>
      </div>

      {
        navigation.footerGroups.map((group) => (
          <nav aria-label={group.title}>
            <h2 class="font-heading text-sm leading-5 font-semibold text-white">{group.title}</h2>
            <ul class="mt-4 flex flex-col gap-2.5 text-sm">
              {group.links.map((link) => (
                <li>
                  <a href={link.href} class="transition-colors hover:text-white">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-10 border-t border-white/10 pt-8">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <h2 class="font-heading flex items-center gap-2 text-sm leading-5 font-semibold text-white">
            <Icon name="clock" size={16} />
            Program
          </h2>
          <ul class="mt-3 flex flex-col gap-1 text-sm sm:flex-row sm:gap-6">
            {
              site.schedule.map((entry) => (
                <li class="flex gap-2">
                  <span>{entry.days}</span>
                  <span class="text-white">{entry.hours}</span>
                </li>
              ))
            }
          </ul>
        </div>

        {
          social.length > 0 && (
            <ul class="flex items-center gap-3">
              {social.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener"
                    aria-label={item.label}
                    class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 transition-colors hover:border-transparent hover:bg-white hover:text-ink"
                  >
                    <Icon name={item.icon} size={16} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <div
      class="mt-8 flex flex-col gap-4 border-t border-white/10 pt-6 text-xs sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {site.name} 2020–{year}. Toate drepturile rezervate.</p>

      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          navigation.footerLegal.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
