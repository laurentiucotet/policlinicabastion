---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  items.length > 1 && (
    <nav class="border-stroke rounded-2xl border p-4" aria-labelledby="cuprins">
      <p id="cuprins" class="text-ink text-sm leading-5 font-semibold">
        Cuprins
      </p>
      <ol class="mt-3 space-y-2">
        {items.map((heading) => (
          <li class:list={[heading.depth === 3 && 'pl-3']}>
            <a href={`#${heading.slug}`} class="text-ink-muted hover:text-brand text-sm leading-5">
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
