---
/** Eticheta de stadiu a unui proiect european: în derulare / încheiat. */
interface Props {
  status: 'in-derulare' | 'incheiat';
  class?: string;
}

const { status, class: className = '' } = Astro.props;

/* Fundal opac, nu translucid: eticheta apare si peste imaginea de copertă a
 * cardului, unde un fundal transparent ar deveni ilizibil. */
const styles = {
  'in-derulare': {
    label: 'În derulare',
    classes: 'bg-surface text-emerald-700 ring-1 ring-emerald-600/25',
    dot: 'bg-whatsapp',
  },
  incheiat: {
    label: 'Încheiat',
    classes: 'bg-surface text-ink-muted ring-1 ring-[color:var(--color-stroke)]',
    dot: 'bg-ink-subtle',
  },
} as const;

const style = styles[status];
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs leading-[18px] font-semibold',
    style.classes,
    className,
  ]}
>
  <span class:list={['h-1.5 w-1.5 rounded-full', style.dot]} aria-hidden="true"></span>
  {style.label}
</span>
