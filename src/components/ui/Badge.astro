---
interface Props {
  class?: string;
  variant?: 'sky' | 'brand';
}
const { class: className = '', variant = 'sky' } = Astro.props;

const variants = {
  sky: 'bg-chip text-chip-ink',
  brand: 'bg-brand-100 text-brand-dark',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-3 py-1.5 text-xs leading-[18px] font-semibold',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
