---
import type { CollectionEntry } from 'astro:content';
import { avatarColor, initials } from '../../lib/utils';

interface Props {
  testimonial: CollectionEntry<'testimoniale'>;
}

const { testimonial } = Astro.props;
const { author, timeAgo, rating, text, source } = testimonial.data;

const sourceLabel = {
  google: 'Recenzie Google verificată',
  facebook: 'Recenzie Facebook',
  site: 'Recenzie primită pe site',
}[source];
---

<figure class="border-stroke bg-surface shadow-card flex h-full flex-col gap-3 rounded-2xl border p-4">
  <div class="flex items-center gap-3">
    <span
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm font-semibold text-white"
      style={`background-color:${avatarColor(author)}`}
      aria-hidden="true">{initials(author)}</span
    >
    <div>
      <figcaption class="text-ink text-sm leading-5 font-semibold">{author}</figcaption>
      <p class="text-ink-subtle text-xs leading-[18px]">{timeAgo}</p>
    </div>
  </div>

  <div class="flex items-center gap-0.5" role="img" aria-label={`${rating} din 5 stele`}>
    {
      Array.from({ length: 5 }).map((_, index) => (
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill={index < rating ? '#f59e0b' : 'none'}
          stroke="#f59e0b"
          stroke-width="2"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2Z" />
        </svg>
      ))
    }
  </div>

  <blockquote class="text-ink-muted flex-1 text-sm leading-6">{text}</blockquote>

  <p class="text-ink-subtle flex items-center gap-2 text-xs">
    <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="#4285F4"
        d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.7v3h3.9c2.3-2.1 3.5-5.2 3.5-8.9Z"></path>
      <path
        fill="#34A853"
        d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.9-3c-1.1.7-2.5 1.2-4 1.2-3.1 0-5.7-2.1-6.6-4.9H1.4v3.1A12 12 0 0 0 12 24Z"></path>
      <path fill="#FBBC05" d="M5.4 14.4a7.2 7.2 0 0 1 0-4.6V6.7H1.4a12 12 0 0 0 0 10.8l4-3.1Z"></path>
      <path
        fill="#EA4335"
        d="M12 4.8c1.8 0 3.3.6 4.5 1.8l3.4-3.4A12 12 0 0 0 1.4 6.7l4 3.1C6.3 6.9 8.9 4.8 12 4.8Z"></path>
    </svg>
    {sourceLabel}
  </p>
</figure>
