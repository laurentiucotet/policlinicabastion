---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'proiecte'>;
}

const { project } = Astro.props;
const href = `/proiecte-europene/${project.id}`;
---

<article
  class="border-stroke bg-surface shadow-card group flex h-full flex-col overflow-hidden rounded-2xl border transition-shadow hover:shadow-md"
>
  <a href={href} class="bg-surface-alt block aspect-[16/9] overflow-hidden" tabindex="-1" aria-hidden="true">
    {
      project.data.cover ? (
        <Image
          src={project.data.cover}
          alt=""
          widths={[416, 832]}
          sizes="(min-width: 1024px) 416px, 100vw"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="from-brand to-brand-dark h-full w-full bg-gradient-to-br" />
      )
    }
  </a>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <h3 class="text-base leading-6 font-semibold">
      <a href={href} class="hover:text-brand">{project.data.title}</a>
    </h3>
    <p class="text-ink-muted line-clamp-3 text-sm leading-5">{project.data.summary}</p>
  </div>
</article>
