---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import BlogCard from '../cards/BlogCard.astro';
import { getArticole, getCategorii } from '../../lib/content';

interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  cta?: { label: string; href: string };
  count?: number;
  tone?: 'white' | 'alt';
  exclude?: string;
}

const { badge, title, subtitle, cta, count = 3, tone = 'white', exclude } = Astro.props;

const [posts, categories] = await Promise.all([getArticole(), getCategorii()]);
const categoryName = new Map(categories.map((category) => [category.id, category.data.name]));
const items = posts.filter((post) => post.id !== exclude).slice(0, count);

const tones = { white: 'bg-surface', alt: 'bg-surface-alt' };
---

{
  items.length > 0 && (
    <section class:list={[tones[tone], 'py-12']}>
      <div class="container-page flex flex-col items-center gap-8">
        {title && <SectionHeading badge={badge} title={title} subtitle={subtitle} />}

        <div class="grid w-full gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((post) => (
            <BlogCard
              post={post}
              categoryName={post.data.category ? categoryName.get(post.data.category.id) : undefined}
            />
          ))}
        </div>

        {cta && (
          <Button href={cta.href} variant="outline">
            {cta.label}
          </Button>
        )}
      </div>
    </section>
  )
}
