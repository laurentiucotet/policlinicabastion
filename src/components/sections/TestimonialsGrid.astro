---
import SectionHeading from '../ui/SectionHeading.astro';
import TestimonialCard from '../cards/TestimonialCard.astro';
import { getTestimoniale } from '../../lib/content';

interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  count?: number;
  tone?: 'white' | 'alt';
}

const { badge, title, subtitle, count = 6, tone = 'alt' } = Astro.props;

const items = (await getTestimoniale()).slice(0, count);
const tones = { white: 'bg-surface', alt: 'bg-surface-alt' };
---

{
  items.length > 0 && (
    <section class:list={[tones[tone], 'py-12']}>
      <div class="container-page flex flex-col items-center gap-8">
        {title && <SectionHeading badge={badge} title={title} subtitle={subtitle} />}
        <div class="grid w-full gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((testimonial) => (
            <TestimonialCard testimonial={testimonial} />
          ))}
        </div>
      </div>
    </section>
  )
}
