---
/**
 * Capul paginilor de catalog (afecțiune / intervenție / serviciu): fir de
 * navigare, etichetă, titlu, denumiri alternative, butoane de acțiune.
 */
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../lib/site';

interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  /** Fir de navigare: ultimul element e pagina curenta, fara link. */
  breadcrumbs: Array<{ label: string; href?: string }>;
  alsoKnownAs?: string[];
  /** Chip-uri sub titlu (specializarea, "Decontat CNAS"...). */
  tags?: Array<{ label: string; href?: string }>;
  /** Butoanele de programare. Ascunse pe paginile fara legatura cu programarea. */
  showCta?: boolean;
}

const { badge, title, subtitle, breadcrumbs, alsoKnownAs = [], tags = [], showCta = true } = Astro.props;

/** Slotul `tags` permite chip-uri proprii (ex. stadiul unui proiect european). */
const hasTagSlot = Astro.slots.has('tags');
---

<section class="bg-surface-alt border-stroke border-b">
  <div class="container-page py-8 lg:py-12">
    <nav aria-label="Fir de navigare">
      <ol class="text-ink-subtle flex flex-wrap items-center gap-1 text-xs">
        {
          breadcrumbs.map((crumb, index) => (
            <li class="flex items-center gap-1">
              {index > 0 && (
                <span class="text-ink-subtle/60" aria-hidden="true">
                  <Icon name="chevron-right" size={12} />
                </span>
              )}
              {crumb.href ? (
                <a href={crumb.href} class="hover:text-brand">
                  {crumb.label}
                </a>
              ) : (
                <span aria-current="page" class="text-ink-muted">
                  {crumb.label}
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="mt-6 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        {badge && <Badge>{badge}</Badge>}
        <h1 class="text-ink mt-3 text-3xl leading-tight font-bold text-balance sm:text-4xl lg:text-5xl">{title}</h1>
        {subtitle && <p class="text-ink-muted mt-3 text-base leading-7 text-pretty">{subtitle}</p>}

        {
          alsoKnownAs.length > 0 && (
            <p class="text-ink-subtle mt-3 text-sm">
              Cunoscută și ca: <span class="text-ink-muted">{alsoKnownAs.join(', ')}</span>
            </p>
          )
        }

        {
          (tags.length > 0 || hasTagSlot) && (
            <ul class="mt-4 flex flex-wrap items-center gap-2">
              <slot name="tags" />
              {tags.map((tag) => (
                <li>
                  {tag.href ? (
                    <a
                      href={tag.href}
                      class="bg-chip text-chip-ink hover:bg-brand-100 hover:text-brand-dark inline-flex rounded-full px-3 py-1.5 text-xs leading-[18px] font-semibold"
                    >
                      {tag.label}
                    </a>
                  ) : (
                    <span class="bg-chip text-chip-ink inline-flex rounded-full px-3 py-1.5 text-xs leading-[18px] font-semibold">
                      {tag.label}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        showCta && (
          <div class="flex shrink-0 flex-wrap gap-2">
            <Button href="/contact">Programează-te</Button>
            <Button href={site.phones[0]?.href} variant="outline">
              <Icon name="phone" size={16} />
              Sună-ne
            </Button>
          </div>
        )
      }
    </div>
  </div>
</section>
