---
/** Sectiune "nume + explicație" (investigații, opțiuni de tratament, ce include). */
import SimpleHeading from '../ui/SimpleHeading.astro';

interface Props {
  id: string;
  title: string;
  intro?: string;
  items: Array<{ name: string; description: string }>;
  tone?: 'white' | 'alt';
}

const { id, title, intro, items, tone = 'white' } = Astro.props;
const tones = { white: 'bg-surface', alt: 'bg-surface-alt' };
---

{
  items.length > 0 && (
    <section id={id} class:list={[tones[tone], 'py-12']}>
      <div class="container-page">
        <SimpleHeading title={title} />
        {intro && <p class="text-ink-muted mt-4 max-w-3xl text-base leading-7">{intro}</p>}

        <div class="mt-8 grid gap-4 md:grid-cols-2">
          {items.map((item) => (
            <div class="border-stroke bg-surface shadow-card rounded-2xl border p-5">
              <h3 class="text-ink text-base leading-6 font-semibold">{item.name}</h3>
              <p class="text-ink-muted mt-2 text-sm leading-6 text-pretty">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
