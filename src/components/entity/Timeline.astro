---
/** Cum decurge intervenția, pas cu pas. Structura fixa pe toate intervențiile. */
import SimpleHeading from '../ui/SimpleHeading.astro';

interface Props {
  id?: string;
  title?: string;
  intro?: string;
  steps: Array<{ title: string; description: string; duration?: string }>;
  tone?: 'white' | 'alt';
}

const { id = 'cum-decurge', title = 'Cum decurge intervenția', intro, steps, tone = 'alt' } = Astro.props;
const tones = { white: 'bg-surface', alt: 'bg-surface-alt' };
---

{
  steps.length > 0 && (
    <section id={id} class:list={[tones[tone], 'py-12']}>
      <div class="container-page">
        <SimpleHeading title={title} />
        {intro && <p class="text-ink-muted mt-4 max-w-3xl text-base leading-7">{intro}</p>}

        <ol class="mt-8 space-y-0">
          {steps.map((step, index) => (
            <li class="relative flex gap-4 pb-8 last:pb-0">
              {index < steps.length - 1 && (
                <span class="bg-stroke absolute top-10 bottom-0 left-[19px] w-px" aria-hidden="true" />
              )}

              <span class="bg-brand font-heading relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white">
                {index + 1}
              </span>

              <div class="border-stroke bg-surface shadow-card flex-1 rounded-2xl border p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="text-ink text-base leading-6 font-semibold">{step.title}</h3>
                  {step.duration && (
                    <span class="bg-chip text-chip-ink rounded-full px-2.5 py-1 text-xs leading-4 font-semibold">
                      {step.duration}
                    </span>
                  )}
                </div>
                <p class="text-ink-muted mt-2 text-sm leading-6 text-pretty">{step.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
