---
import { render, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTitleHeader from '../../components/sections/PageTitleHeader.astro';
import TableOfContents from '../../components/ui/TableOfContents.astro';
import SidebarPostList from '../../components/ui/SidebarPostList.astro';
import ShareRibbon from '../../components/ui/ShareRibbon.astro';
import LatestNews from '../../components/sections/LatestNews.astro';
import { getArticole } from '../../lib/content';
import { formatDate, isoDate } from '../../lib/utils';
import { site } from '../../lib/site';
import { clinicRef } from '../../lib/schema';
import ReadingProgress from '../../components/ui/ReadingProgress.astro';

export const getStaticPaths = (async () => {
  const posts = await getArticole();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      sidebarPosts: posts.filter((item) => item.id !== post.id).slice(0, 5),
    },
  }));
}) satisfies GetStaticPaths;

const { post, sidebarPosts } = Astro.props;
const { Content, headings } = await render(post);
const { title, date, updated, excerpt, cover, coverAlt, category, author, seo } = post.data;

const categoryEntry = category ? await getEntry(category): undefined;
const authorEntry = author ? await getEntry(author): undefined;
const url = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();

/**
 * `MedicalWebPage`, nu doar `Article`: textul e conținut medical, iar tipul
 * spune asta explicit. Autorul trimite la pagina medicului, iar editorul la
 * clinică prin `@id`, vezi `lib/schema.ts` pentru graf.
 */
const schema = {
  '@type': ['Article', 'MedicalWebPage'],
  headline: title,
  description: excerpt,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  inLanguage: 'ro-RO',
  author: authorEntry
    ? {
        '@type': 'Physician',
        name: authorEntry.data.name,
        jobTitle: authorEntry.data.role,
        url: new URL(`/medici/${authorEntry.id}`, origin).toString(),
        worksFor: clinicRef(origin),
      }
: clinicRef(origin),
  publisher: clinicRef(origin),
  mainEntityOfPage: url,
};
---

<BaseLayout
  title={seo?.title ?? title}
  description={seo?.description ?? excerpt}
  noindex={seo?.noindex}
  schema={schema}
>
  <PageTitleHeader
    breadcrumbs={[
      { label: 'Noutăți', href: '/noutati' },
...(categoryEntry
        ? [{ label: categoryEntry.data.name, href: `/noutati/categorie/${categoryEntry.id}` }]
: []),
      { label: title },
    ]}
    badge={categoryEntry?.data.name ?? 'Blog & Noutăți'}
    title={title}
    subtitle={excerpt}
  />

  <ReadingProgress />

  <section class="bg-surface py-12">
    <div class="container-page grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
      <article>
        {
          cover && (
            <Image
              src={cover}
              alt={coverAlt ?? ''}
              widths={[640, 928, 1856]}
              sizes="(min-width: 1024px) 928px, 100vw"
              class="mb-8 aspect-[16/9] w-full rounded-2xl object-cover"
            />
          )
        }

        <p class="text-ink-subtle flex flex-wrap items-center gap-2 text-xs">
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          {
            authorEntry && (
              <>
                <span aria-hidden="true">·</span>
                <a href={`/medici/${authorEntry.id}`} class="hover:text-brand">
                  {authorEntry.data.name}
                </a>
              </>
            )
          }
        </p>

        <div class="prose-bastion mt-6 max-w-none" data-article-body>
          <Content />
        </div>

        <div class="mt-10">
          <ShareRibbon title={title} url={url} />
        </div>
      </article>

      <aside class="flex flex-col gap-6 lg:sticky lg:top-40 lg:self-start">
        <TableOfContents headings={headings} />
        <SidebarPostList posts={sidebarPosts} />
      </aside>
    </div>
  </section>

  <LatestNews title="Alte articole" subtitle="Continuă lectura" exclude={post.id} tone="alt" count={3} />
</BaseLayout>
