---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTitleHeader from '../../components/sections/PageTitleHeader.astro';
import CatalogBrowser from '../../components/catalog/CatalogBrowser.astro';
import type { CatalogGroup, CatalogItem } from '../../lib/catalog';
import CtaBand from '../../components/sections/CtaBand.astro';
import { getInterventii, getSpecializari } from '../../lib/content';
import { home } from '../../lib/site';

const [interventii, specializari] = await Promise.all([getInterventii(), getSpecializari()]);

const groups: CatalogGroup[] = specializari.map((speciality) => ({
  id: speciality.id,
  label: speciality.data.title,
  icon: speciality.data.icon,
  href: `/specializari/${speciality.id}`,
}));

const items: CatalogItem[] = interventii.map((item) => ({
  id: item.id,
  title: item.data.title,
  description: item.data.shortDescription,
  href: `/interventii/${item.id}`,
  groupId: item.data.speciality.id,
  keywords: item.data.keywords,
  meta: [item.data.admission, item.data.anesthesia, item.data.cnas ? 'Decontat CNAS' : undefined].filter(
    (value): value is string => Boolean(value),
  ),
}));
---

<BaseLayout
  title="Intervenții și proceduri"
  description="Catalogul intervențiilor și procedurilor efectuate la Policlinica Bastion Timișoara: indicații, pregătire, cum decurg pas cu pas, recuperare și întrebări frecvente."
>
  <PageTitleHeader
    badge="Intervenții"
    title="Intervenții și proceduri"
    subtitle="Fiecare intervenție are aceeași structură: când este recomandată, cum te pregătești, cum decurge pas cu pas, ce urmează după și răspunsuri la întrebările frecvente."
  />

  <CatalogBrowser
    items={items}
    groups={groups}
    noun="intervenții"
    searchPlaceholder="Ex: biopsie, litotriție, cistoscopie..."
    allLabel="Toate intervențiile"
    emptyText="Nicio intervenție nu corespunde căutării. Încearcă alt termen sau sună-ne la recepție."
  />

  <CtaBand title={home.ctaPrimary.title} text={home.ctaPrimary.text} cta={home.ctaPrimary.cta} tone="alt" />
</BaseLayout>
