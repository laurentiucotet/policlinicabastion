---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTitleHeader from '../../components/sections/PageTitleHeader.astro';
import SimpleHeading from '../../components/ui/SimpleHeading.astro';
import LatestNews from '../../components/sections/LatestNews.astro';
import { getProiecte } from '../../lib/content';

export const getStaticPaths = (async () => {
  const projects = await getProiecte();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const { title, subtitle, summary, details, gallery, seo } = project.data;
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? summary} noindex={seo?.noindex}>
  <PageTitleHeader badge="Proiecte Europene" title={title} subtitle={subtitle} />

  {
    details.length > 0 && (
      <section class="bg-surface py-12">
        <div class="container-page">
          <div class="border-stroke bg-surface-alt rounded-2xl border p-6">
            <dl class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
              {details.map((detail) => (
                <div>
                  <dt class="text-ink-subtle text-xs leading-[18px] font-semibold uppercase">{detail.label}</dt>
                  <dd class="text-ink mt-1 text-sm leading-6">{detail.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-surface pb-12">
    <div class="container-page">
      <SimpleHeading title="Despre proiect" />
      <div class="prose-bastion mt-8 max-w-none">
        <Content />
      </div>
    </div>
  </section>

  {
    gallery.length > 0 && (
      <section class="bg-surface-alt py-12">
        <div class="container-page grid gap-4 sm:grid-cols-2">
          {gallery.map((image) => (
            <Image
              src={image}
              alt=""
              widths={[640, 1280]}
              sizes="(min-width: 640px) 50vw, 100vw"
              class="w-full rounded-2xl object-cover"
            />
          ))}
        </div>
      </section>
    )
  }

  <LatestNews title="Noutăți" subtitle="Ultimele articole publicate" count={3} />
</BaseLayout>
