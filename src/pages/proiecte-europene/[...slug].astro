---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntityHeader from '../../components/entity/EntityHeader.astro';
import KeyFacts from '../../components/entity/KeyFacts.astro';
import PointsSection from '../../components/entity/PointsSection.astro';
import NamedListSection from '../../components/entity/NamedListSection.astro';
import RelatedArticles from '../../components/entity/RelatedArticles.astro';
import ProjectStatus from '../../components/ui/ProjectStatus.astro';
import SimpleHeading from '../../components/ui/SimpleHeading.astro';
import Button from '../../components/ui/Button.astro';
import { getArticoleForProiect, getProiecte } from '../../lib/content';

export const getStaticPaths = (async () => {
  const projects = await getProiecte();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const {
  title,
  subtitle,
  summary,
  status,
  beneficiary,
  program,
  smis,
  contractNumber,
  period,
  totalValue,
  grantValue,
  details,
  objectives,
  results,
  gallery,
  seo,
} = project.data;

const articles = await getArticoleForProiect(project);

/** Datele de identificare, obligatorii pentru vizibilitatea finanțării. */
const facts = [
  period && { label: 'Perioadă de implementare', value: period },
  smis && { label: 'Cod SMIS', value: smis },
  program && { label: 'Program de finanțare', value: program },
  beneficiary && { label: 'Beneficiar', value: beneficiary },
  contractNumber && { label: 'Contract de finanțare', value: contractNumber },
  totalValue && { label: 'Valoare totală', value: totalValue },
  grantValue && { label: 'Valoare nerambursabilă', value: grantValue },
  ...details,
].filter((fact): fact is { label: string; value: string } => Boolean(fact));

---

<BaseLayout
  title={seo?.title ?? title}
  description={seo?.description ?? summary}
  noindex={seo?.noindex}
>
  <EntityHeader
    badge="Proiecte Europene"
    title={title}
    subtitle={subtitle ?? summary}
    breadcrumbs={[{ label: 'Proiecte Europene', href: '/proiecte-europene' }, { label: title }]}
    showCta={false}
  >
    <ProjectStatus status={status} slot="tags" />
  </EntityHeader>

  <KeyFacts facts={facts} />

  <section class="bg-surface py-12">
    <div class="container-page">
      <SimpleHeading title="Despre proiect" />
      <div class="prose-bastion mt-8 max-w-3xl">
        <Content />
      </div>
    </div>
  </section>

  <PointsSection
    id="obiective"
    title="Obiectivele proiectului"
    items={objectives}
    variant="check"
    tone="alt"
  />

  <NamedListSection
    id="rezultate"
    title="Rezultate"
    intro="Ce a intrat efectiv în dotarea clinicii prin acest proiect."
    items={results}
  />

  {
    gallery.length > 0 && (
      <section class="bg-surface-alt py-12">
        <div class="container-page">
          <SimpleHeading title="Galerie" />
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {gallery.map((image) => (
              <Image
                src={image}
                alt=""
                widths={[640, 1280]}
                sizes="(min-width: 640px) 50vw, 100vw"
                class="w-full rounded-2xl object-cover"
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <RelatedArticles
    posts={articles}
    badge="Noutăți"
    title="Noutăți despre proiect"
    subtitle="Anunțuri și articole publicate pe parcursul implementării."
    tone="white"
  />

  <section class="bg-surface-alt py-12">
    <div class="container-page flex flex-col gap-6">
      <p class="border-stroke text-ink-subtle bg-surface rounded-2xl border p-6 text-sm leading-6">
        Conținutul acestui material nu reprezintă în mod obligatoriu poziția oficială a Uniunii Europene sau a
        Guvernului României.
      </p>
      <Button href="/proiecte-europene" variant="outline" class="self-start">
        Vezi toate proiectele
      </Button>
    </div>
  </section>
</BaseLayout>
