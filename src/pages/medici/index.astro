---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTitleHeader from '../../components/sections/PageTitleHeader.astro';
import TeamGrid from '../../components/sections/TeamGrid.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { home } from '../../lib/site';
import { collectionSchema } from '../../lib/schema';
import { getMedici } from '../../lib/content';

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
const medici = await getMedici();
const schema = collectionSchema({
  origin,
  name: 'Echipa medicală',
  description: 'Medicii Policlinicii Bastion din Timișoara.',
  items: medici.map((medic) => ({ name: medic.data.name, url: `/medici/${medic.id}` })),
});
---

<BaseLayout schema={schema} title="Echipa noastră" description="Medicii Policlinicii Bastion din Timișoara.">
  <PageTitleHeader
    breadcrumbs={[{ label: 'Medici' }]}
    badge="Medici"
    title="Echipa noastră"
    subtitle="Profesori universitari, conferențiari și medici primari cu experiență clinică și de cercetare."
  />
  <TeamGrid title="" count={200} />
  <CtaBand title={home.ctaSecondary.title} text={home.ctaSecondary.text} cta={home.ctaSecondary.cta} tone="alt" />
</BaseLayout>
