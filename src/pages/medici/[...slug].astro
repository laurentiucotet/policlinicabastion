---
import { render, getEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DoctorHero from '../../components/sections/DoctorHero.astro';
import SimpleHeading from '../../components/ui/SimpleHeading.astro';
import ListColumns from '../../components/sections/ListColumns.astro';
import ServicesAccordion from '../../components/sections/ServicesAccordion.astro';
import RelatedCards from '../../components/entity/RelatedCards.astro';
import TeamGrid from '../../components/sections/TeamGrid.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { getAfectiuniBySpecialitate, getMedici, getServiciiForMedic } from '../../lib/content';
import { serviceTypes } from '../../lib/catalog';
import { formatPrice, hasPrice } from '../../lib/utils';
import type { Price } from '../../lib/utils';
import { home, site } from '../../lib/site';
import { physicianSchema } from '../../lib/schema';

export const getStaticPaths = (async () => {
  const items = await getMedici();
  return items.map((doctor) => ({ params: { slug: doctor.id }, props: { doctor } }));
}) satisfies GetStaticPaths;

const { doctor } = Astro.props;
const { Content } = await render(doctor);
const { name, role, procedures, pathologies, education, memberships, specialities, seo } = doctor.data;

// Serviciile afisate pe pagina de medic vin din prima lui specializare,
// ca sa nu fie nevoie sa fie duplicate in CMS.
const primarySpeciality = specialities[0] ? await getEntry(specialities[0]): undefined;

// Interventiile pe care le efectueaza si afectiunile din specializarile lui:
// relatia e declarata o singura data, pe interventie / pe afectiune.
const servicii = await getServiciiForMedic(doctor);
const interventii = servicii.filter((item) => item.data.type === 'interventie');
const alteServicii = servicii.filter((item) => item.data.type !== 'interventie');
const afectiuni = (
  await Promise.all(specialities.map((ref) => getAfectiuniBySpecialitate(ref.id)))
).flat();

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();
const schema = physicianSchema(doctor, origin, primarySpeciality?.data.title);

/* Descrierea din rezultatele cautarii. Se compune din date reale (nume, rol,
 * telefonul din setari), ca sa spuna cui se adreseaza pagina si ce poate face
 * omul mai departe, o singura propozitie de identificare ar fi prea saraca
 * pentru a-l convinge sa intre. */
const defaultDescription = `${name}, ${role.toLowerCase()} la Policlinica Bastion din Timișoara. Consultații în regim ambulatoriu; programări la ${site.phones[0]?.value ?? site.topBar.phonesShort}.`;

/** Pretul apare pe card doar daca e completat; altfel ar fi doar zgomot. */
const priceChip = (price?: Price) => (hasPrice(price) ? formatPrice(price): undefined);
---

<BaseLayout
  title={seo?.title ?? name}
  description={seo?.description ?? defaultDescription}
  noindex={seo?.noindex}
  schema={schema}
>
  <DoctorHero doctor={doctor} />

  <section class="bg-surface py-12">
    <div class="container-page">
      <SimpleHeading title="Despre medic" />
      <div class="prose-bastion mt-8 max-w-none">
        <Content />
      </div>
    </div>
  </section>

  <ListColumns title="Proceduri și investigații" items={procedures} tone="alt" />
  <ListColumns title="Patologii tratate" items={pathologies} />
  <ListColumns title="Formare profesională" items={education} tone="alt" />
  <ListColumns title="Afilieri profesionale" items={memberships} />

  <RelatedCards
    badge="Intervenții"
    title="Intervenții efectuate"
    subtitle="Pentru fiecare intervenție găsești indicațiile, pregătirea, pașii și recuperarea."
    tone="alt"
    items={interventii.map((item) => ({
      href: `/servicii/${item.id}`,
      title: item.data.title,
      description: item.data.shortDescription,
      eyebrow: 'Intervenție',
      meta: [priceChip(item.data.price), item.data.admission, item.data.anesthesia].filter(
        (value): value is string => Boolean(value),
      ),
    }))}
    cta={{ label: 'Vezi toate intervențiile', href: '/servicii?tip=interventie' }}
  />

  <RelatedCards
    badge="Afecțiuni"
    title="Afecțiuni din specializările sale"
    subtitle="Fiecare afecțiune are pagina ei: simptome, cauze, diagnostic și cum se tratează."
    items={afectiuni.map((item) => ({
      href: `/afectiuni/${item.id}`,
      title: item.data.title,
      description: item.data.shortDescription,
      eyebrow: 'Afecțiune',
    }))}
    cta={{ label: 'Vezi toate afecțiunile', href: '/afectiuni' }}
  />

  <RelatedCards
    badge="Servicii"
    title="Servicii pe care le poți programa"
    items={alteServicii.map((item) => ({
      href: `/servicii/${item.id}`,
      title: item.data.title,
      description: item.data.shortDescription,
      eyebrow: serviceTypes[item.data.type],
      meta: [priceChip(item.data.price), item.data.cnas ? 'Decontat CNAS': undefined].filter(
        (value): value is string => Boolean(value),
      ),
    }))}
    tone="alt"
    cta={{ label: 'Vezi toate serviciile', href: '/servicii' }}
  />

  {
    /* Fara pagini de serviciu pentru specializare, ramane acordeonul din
       descrierea specializarii. */
    servicii.length === 0 && primarySpeciality && (
      <ServicesAccordion
        title={`Servicii ${primarySpeciality.data.title.toLowerCase()}`}
        services={primarySpeciality.data.services}
      />
    )
  }

  <CtaBand title={home.ctaPrimary.title} text={home.ctaPrimary.text} cta={home.ctaPrimary.cta} />

  <TeamGrid
    badge="Medici"
    title="Alți medici"
    subtitle="Descoperă restul echipei Policlinica Bastion."
    exclude={doctor.id}
    count={4}
    cta={{ label: 'Vezi toți medicii', href: '/medici' }}
  />
</BaseLayout>
