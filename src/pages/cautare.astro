---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitleHeader from '../components/sections/PageTitleHeader.astro';
---

<BaseLayout title="Căutare" noindex>
  <PageTitleHeader badge="Căutare" title="Caută pe site" subtitle="Specializări, medici, articole și proiecte." />

  <section class="bg-surface py-12">
    <div class="container-page mx-auto max-w-3xl">
      <label class="sr-only" for="q">Caută</label>
      <input
        id="q"
        type="search"
        placeholder="Ex: nefrologie, biopsie, dr. Lațcu..."
        autocomplete="off"
        class="border-stroke text-ink placeholder:text-ink-subtle focus:border-brand w-full rounded-lg border px-4 py-3 text-base focus:outline-none"
      />

      <p id="cautare-stare" class="text-ink-subtle mt-4 text-sm">Scrie cel puțin 2 caractere.</p>
      <ul id="cautare-rezultate" class="divide-stroke mt-2 divide-y"></ul>
    </div>
  </section>
</BaseLayout>

<script>
  type Entry = { type: string; title: string; description: string; url: string };

  const input = document.getElementById('q') as HTMLInputElement | null;
  const list = document.getElementById('cautare-rezultate');
  const state = document.getElementById('cautare-stare');

  const normalize = (value: string) =>
    value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');

  let entries: Entry[] = [];

  const load = async () => {
    if (entries.length) return;
    const response = await fetch('/cautare-index.json');
    entries = await response.json();
  };

  const render = (results: Entry[]) => {
    if (!list || !state) return;
    list.innerHTML = results
      .map(
        (entry) => `
          <li class="py-3">
            <a href="${entry.url}" class="group block">
              <span class="text-xs font-semibold text-chip-ink">${entry.type}</span>
              <span class="block text-base font-semibold text-ink group-hover:text-brand">${entry.title}</span>
              <span class="block text-sm text-ink-muted">${entry.description}</span>
            </a>
          </li>`,
      )
      .join('');
    state.textContent = results.length ? `${results.length} rezultate` : 'Niciun rezultat.';
  };

  const search = async () => {
    const query = normalize(input?.value.trim() ?? '');
    if (query.length < 2) {
      if (list) list.innerHTML = '';
      if (state) state.textContent = 'Scrie cel puțin 2 caractere.';
      return;
    }
    await load();
    render(
      entries.filter((entry) => normalize(`${entry.title} ${entry.description} ${entry.type}`).includes(query)),
    );
  };

  input?.addEventListener('input', search);

  // Permite /cautare?q=termen
  const initial = new URLSearchParams(location.search).get('q');
  if (initial && input) {
    input.value = initial;
    void search();
  }
</script>
