# ---------------------------------------------------------------------------
# TinaCMS (app.tina.io -> proiectul tau -> Overview)
# ---------------------------------------------------------------------------
# Client ID-ul proiectului din Tina Cloud. Este PUBLIC (ajunge in bundle-ul
# panoului /admin) - prefixul TINA_PUBLIC_ ii spune lui Tina sa il expuna.
TINA_PUBLIC_CLIENT_ID=""

# Token READ-ONLY generat din Tina Cloud. Secret: doar in variabilele Vercel.
TINA_TOKEN=""

# Branch-ul din care Tina citeste/scrie continutul.
# Pe Vercel se completeaza automat din VERCEL_GIT_COMMIT_REF daca lipseste.
TINA_BRANCH="main"

# Optional: cautarea in panoul de admin
TINA_SEARCH_TOKEN=""

# ---------------------------------------------------------------------------
# Formular de contact (optional - fara el, mesajele doar se logheaza)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
CONTACT_TO_EMAIL="receptie@policlinicabastion.ro"
CONTACT_FROM_EMAIL="site@policlinicabastion.ro"
